# === Football-Data.co.uk ===
# Pas de clé API nécessaire (fichiers CSV publics)

# === Understat ===
# Pas de clé API nécessaire (scraping avec cache)
UNDERSTAT_CACHE_DIR=data/raw/understat

# === API-Football ===
API_FOOTBALL_KEY=your_api_football_key_here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# === The Odds API ===
ODDS_API_KEY=your_odds_api_key_here
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# === Base de données ===
DATABASE_URL=sqlite:///data/pronostic.db

# === Application ===
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# === Logs ===
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# === Cache ===
CACHE_DIR=data/cache
CACHE_TTL_HOURS=24

# === Pipeline ===
PIPELINE_DAILY_HOUR=6
PIPELINE_PREDICTION_HOUR=10
BACKUP_DIR=data/backups
